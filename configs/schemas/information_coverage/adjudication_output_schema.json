{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["poster_id", "paper_read_status", "reviews"],
  "properties": {
    "poster_id": {"type": "string"},
    "paper_read_status": {"type": "string", "enum": ["READ", "UNREADABLE"]},
    "reviews": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "decision",
          "final_verdict",
          "final_issue_type",
          "reasoning",
          "evidence",
          "recommended_statement",
          "confidence"
        ],
        "properties": {
          "unit_id": {"type": "string"},
          "decision": {"type": "string", "enum": ["CONFIRM", "REVISE", "DISMISS"]},
          "final_verdict": {
            "type": "string",
            "enum": ["SUPPORTED", "SUPPORTED_WITH_NARROWING", "NOT_FOUND", "CONTRADICTED"]
          },
          "final_issue_type": {
            "type": "string",
            "enum": [
              "NONE",
              "OVERSTATEMENT",
              "EXTRA_DETAIL",
              "NUMERIC_MISMATCH",
              "CLAIM_MISMATCH",
              "POSTER_ONLY",
              "VERSION_MISMATCH",
              "COMPOUND_PARTIAL_SUPPORT",
              "UNVERIFIABLE"
            ]
          },
          "reasoning": {"type": "string"},
          "evidence": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["page", "location", "quote"],
              "properties": {
                "page": {"type": "integer", "minimum": 1},
                "location": {"type": "string"},
                "quote": {"type": "string"}
              }
            }
          },
          "recommended_statement": {"type": "string"},
          "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]}
        }
      }
    }
  }
}

