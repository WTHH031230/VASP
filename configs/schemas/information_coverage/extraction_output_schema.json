{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["poster_id", "title", "information_units"],
  "properties": {
    "poster_id": {"type": "string"},
    "title": {"type": "string"},
    "information_units": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "information_type",
          "topic",
          "local_context",
          "statement",
          "coverage_requirement",
          "official_evidence"
        ],
        "properties": {
          "unit_id": {"type": "string"},
          "information_type": {"type": "string"},
          "topic": {"type": "string"},
          "local_context": {"type": "string"},
          "statement": {"type": "string"},
          "coverage_requirement": {"type": "string"},
          "official_evidence": {"type": "string"}
        }
      }
    }
  }
}
