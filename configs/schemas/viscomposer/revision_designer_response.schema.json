{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file_edits",
    "design_state",
    "critique",
    "summary"
  ],
  "properties": {
    "file_edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "old_text",
          "new_text",
          "reason"
        ],
        "properties": {
          "file": {
            "enum": [
              "poster.html",
              "style.css"
            ],
            "type": "string"
          },
          "old_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "new_text": {
            "type": "string",
            "maxLength": 3000
          },
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 400
          }
        }
      }
    },
    "design_state": {
      "$ref": "design_state.schema.json"
    },
    "critique": {
      "$ref": "initial_designer_response.schema.json#/$defs/critique"
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    }
  }
}
