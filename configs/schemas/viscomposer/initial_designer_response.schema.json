{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["poster_html", "style_css", "design_state", "critique", "summary"],
  "properties": {
    "poster_html": {"type": "string", "minLength": 1000},
    "style_css": {"type": "string", "minLength": 1000},
    "design_state": {"$ref": "design_state.schema.json"},
    "critique": {"$ref": "#/$defs/critique"},
    "summary": {"type": "string", "minLength": 20, "maxLength": 1000}
  },
  "$defs": {
    "critique": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint", "diagnosis", "decisions", "risks"],
      "properties": {
        "checkpoint": {"type": "integer", "minimum": 0, "maximum": 9},
        "diagnosis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"type": "string", "minLength": 8, "maxLength": 500}
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"type": "string", "minLength": 8, "maxLength": 500}
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"type": "string", "minLength": 8, "maxLength": 500}
        }
      }
    }
  }
}
