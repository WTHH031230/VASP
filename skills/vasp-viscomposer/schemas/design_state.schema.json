{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistent Poster Design State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_title",
    "poster_title",
    "concept",
    "stages",
    "territories",
    "nodes",
    "edges",
    "reading_order",
    "visual_hierarchy",
    "type_scale",
    "decision_log"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "paper_title": {
      "type": "string",
      "minLength": 12,
      "maxLength": 300,
      "description": "Exact paper title copied from extracted metadata."
    },
    "poster_title": {
      "type": "string",
      "minLength": 12,
      "maxLength": 300,
      "description": "Exact immutable paper title used by the visible poster H1."
    },
    "concept": {
      "type": "string",
      "minLength": 30,
      "maxLength": 700
    },
    "stages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "title",
          "purpose",
          "node_ids"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "role": {
            "$ref": "#/$defs/story_role"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "purpose": {
            "type": "string",
            "minLength": 12,
            "maxLength": 300
          },
          "node_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "territories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "purpose",
          "width_weight",
          "node_ids"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "purpose": {
            "type": "string",
            "minLength": 12,
            "maxLength": 300
          },
          "width_weight": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 8
          },
          "node_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "semantic_role",
          "stage_id",
          "summary",
          "priority"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "claim",
              "figure",
              "table",
              "equation",
              "algorithm",
              "transition",
              "context",
              "conclusion",
              "branding"
            ],
            "type": "string"
          },
          "semantic_role": {
            "$ref": "#/$defs/semantic_role"
          },
          "stage_id": {
            "$ref": "#/$defs/id"
          },
          "summary": {
            "type": "string",
            "minLength": 4,
            "maxLength": 400
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 3,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "relation"
        ],
        "properties": {
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "relation": {
            "enum": [
              "explains",
              "supports",
              "derives",
              "qualifies",
              "contrasts",
              "continues"
            ],
            "type": "string"
          }
        }
      }
    },
    "reading_order": {
      "type": "array",
      "minItems": 5,
      "maxItems": 36,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "visual_hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_anchor",
        "secondary_anchors",
        "rationale"
      ],
      "properties": {
        "primary_anchor": {
          "$ref": "#/$defs/id"
        },
        "secondary_anchors": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        }
      }
    },
    "type_scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_px",
        "chapter_px",
        "group_px",
        "body_px",
        "caption_px"
      ],
      "properties": {
        "title_px": {
          "type": "number",
          "minimum": 60,
          "maximum": 96
        },
        "chapter_px": {
          "type": "number",
          "minimum": 28,
          "maximum": 48
        },
        "group_px": {
          "type": "number",
          "minimum": 22,
          "maximum": 38
        },
        "body_px": {
          "type": "number",
          "minimum": 17,
          "maximum": 30
        },
        "caption_px": {
          "type": "number",
          "minimum": 16,
          "maximum": 24
        }
      }
    },
    "decision_log": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 400
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,48}$"
    },
    "semantic_role": {
      "enum": [
        "identity",
        "framing",
        "overview",
        "mechanism",
        "result",
        "takeaway"
      ],
      "type": "string"
    },
    "story_role": {
      "type": "string",
      "enum": [
        "framing",
        "overview",
        "mechanism",
        "result",
        "takeaway"
      ]
    }
  }
}
